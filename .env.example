# Root env for docker-compose. Copy to .env and override for production.
# All values have safe local defaults in docker-compose.yml.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cafe_platform

# Secrets — CHANGE THESE in production
JWT_SECRET=change-me-in-production-32-chars-min
JWT_REFRESH_SECRET=change-me-refresh-different-secret

# Comma-separated origins allowed to call the API (the admin SPA origin)
ALLOWED_ORIGINS=http://localhost:8080

# Anthropic key for the AI procurement agent (sk-ant-placeholder = rule-based fallback)
ANTHROPIC_API_KEY=sk-ant-placeholder

# Telegram bot for supplier notifications (optional). Get a token from @BotFather.
# Leave as changeme to disable Telegram notifications.
TELEGRAM_BOT_TOKEN=changeme

# API base URL baked into the admin SPA at build time
VITE_API_URL=http://localhost:3000
